# ============================================================
# Arma Reforger Panel — Configuration Template
# Copy this file:  cp config.env.example config.env
# Then fill in your values.
# ============================================================

# Bcrypt hash of your panel admin password. The install script generates this
# automatically. To set/rotate it manually:
#   pip install bcrypt
#   python3 -c 'import bcrypt,getpass; \
#     print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())'
PANEL_PASSWORD_HASH=

# Legacy plaintext password — only used if PANEL_PASSWORD_HASH is empty.
# Keep this empty in production; install.sh will hash it for you on first run.
# PANEL_PASSWORD=

# Port the panel listens on
PANEL_PORT=8888

# Address the panel listens on. 0.0.0.0 = all interfaces. Set 127.0.0.1 when
# an HTTPS reverse proxy (Caddy, nginx) on the same machine sits in front, so
# the unencrypted port can't be reached from outside.
PANEL_HOST=0.0.0.0

# Set to true when the panel is served over HTTPS (behind a reverse proxy).
# The session cookie is then never sent over plain HTTP.
SECURE_COOKIES=false

# Path to your Arma Reforger server binary directory
# (On Windows use Windows paths, e.g. SERVER_DIR=C:\arma\server — see README.)
SERVER_DIR=/home/arma/server

# Full path to your server config.json
SERVER_CONFIG=/home/arma/server/config.json

# Server 2 runs from the same installation with its own config file.
# Defaults to config2.json in the same folder as SERVER_CONFIG.
# SERVER2_CONFIG=

# Server 2's own profile folder, passed as -profile: its saves end up in
# <folder>/profile/.save and its logs in <folder>/logs. Defaults to a folder
# next to server 1's, e.g. Documents\My Games\ArmaReforger-Server2.
# SERVER2_PROFILE=

# Server 2 has its own mods folder: it is started with -addonDownloadDir set
# to this folder and downloads its mods into <this folder>\addons. Defaults to
# its profile folder (SERVER2_PROFILE), e.g. ...\ArmaReforger-Server2\addons.
# SERVER2_ADDON_DOWNLOAD_DIR=

# Arma Reforger log directory (where logs_<timestamp>/console.log lives)
LOG_DIR=/home/arma/.config/ArmaReforger/logs

# Where the Reforger server downloads workshop addons. The panel scans the
# .pak files here for scenario IDs.
WORKSHOP_DIR=/home/arma/.local/share/Arma Reforger/addons

# Reforger profile directory. Session saves are written under
# `<PROFILE_DIR>/.save/{game,playersave,settings}/`. The Persistence card in
# the panel scans and flushes saves here. Defaults to
# `<parent-of-LOG_DIR>/profile` if left unset.
PROFILE_DIR=/home/arma/.config/ArmaReforger/profile

# Server FPS cap (passed as -maxFPS argument on startup)
# Leave blank to disable
MAX_FPS=60

# Seconds Stop / Soft restart wait for the server to save the game state and
# exit. If it takes longer, the panel reports an error and leaves it running.
SHUTDOWN_TIMEOUT=180

# Every day at this time (HH:MM in DAILY_RESTART_TZ) each running server gets a
# soft restart: it saves the game state, exits and starts again from the save.
# Servers that are stopped are left alone. Set DAILY_RESTART_TIME=off to turn
# it off. DAILY_RESTART_TZ is a time zone name such as Europe/Copenhagen.
DAILY_RESTART_TIME=04:00
DAILY_RESTART_TZ=Europe/Copenhagen

# Stats file written by the Server Admin Tools mod, shown in the Current Status
# box and the FPS graph. Defaults to <PROFILE_DIR>/serveradmintools_stats.json.
# STATS_FILE=
# Server 2's Server Admin Tools stats file. Defaults to
# <SERVER2_PROFILE>/profile/serveradmintools_stats.json.
# SERVER2_STATS_FILE=
